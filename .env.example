# Copie este arquivo para apps/api/.env

# DEV: postgresql://postgres:postgres@localhost:5432/agencia_foto_dev
# PROD: postgresql://<user>:<senha>@<host>:5432/agencia_foto_prod
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agencia_foto_dev

# DB 0 para a aplicação (Evolution API usa o DB 6)
REDIS_URL=redis://localhost:6379

# Evolution API (WhatsApp)
# URL interna Docker → http://evolution_api:8080 (container-to-container)
# URL externa local  → http://localhost:8080
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=agencia-evo-dev-key
EVOLUTION_INSTANCE_NAME=

# Google Routes API
GOOGLE_MAPS_API_KEY=

# Groq (LLM)
GROQ_API_KEY=

PORT=3000
NODE_ENV=development
